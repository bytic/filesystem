{
  "name": "bytic/filesystem",
  "type": "library",
  "description": "filesystem module for bytic framework",
  "homepage": "https://github.com/bytic/filesystem",
  "license": "MIT",
  "authors": [
    {
      "name": "Gabriel Solomon",
      "email": "hello@gabrielsolomon.ro"
    }
  ],
  "autoload": {
    "psr-4": {
      "Nip\\Filesystem\\": "src"
    },
    "classmap": [
      "legacy"
    ],
    "files": [
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Nip\\Filesystem\\Tests\\": "tests/src"
    }
  },
  "require": {
    "php": "^8.0.2",
    "bytic/config": "^1.0|^2.0",
    "bytic/cache": "^1.0|^2.0",
    "bytic/container": "^0.9|^1.0|^2.0",
    "bytic/utility": "^1.0",
    "symfony/filesystem": "^5.4|^6.0|^7.0|^8.0",
    "symfony/http-foundation": "^5.4|^6.0|^7.0|^8.0",
    "league/flysystem": "^3.35.3"
  },
  "require-dev": {
    "league/flysystem-aws-s3-v3": "^3.0",
    "bytic/http": "^1.0|^2.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^9.6|^10.0|^11.0|^12.0|^13.0"
  },
  "suggest": {
    "league/flysystem-aws-s3-v3": "Required to use the Flysystem S3 driver (^3.0)."
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
